{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. ToyQuant (CSV mode)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/toy_quant",
      "args": [
        "csv",
        "data/synthetic_ticks.csv",
        "0"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "Build toy_quant"
    },
    {
      "name": "2. ToyQuant (UDP mode)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/toy_quant",
      "args": [
        "udp",
        "9000"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "Build toy_quant"
    },
    {
      "name": "3. Backtest Main (Backtest mode)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/backtest_main",
      "args": [
        "data/synthetic_ticks.csv",
        "data/orders.csv",
        "data/trades.csv",
        "0.0005",
        "0.0002",
        "backtest",
        "logs/backtest.log"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "Build backtest_main"
    }
  ]
}