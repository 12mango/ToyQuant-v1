{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. HFT Demo (CSV 模式)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/hft_demo",
      "args": [
        "csv",
        "data/synthetic_ticks.csv",
        "0"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "Build hft_demo"
    },
    {
      "name": "2. HFT Demo (UDP 接收模式)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/hft_demo",
      "args": [
        "udp",
        "9000"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "Build hft_demo"
    },
    {
      "name": "3. Backtest Main (经典回测驱动)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/backtest_main",
      "args": [
        "data/synthetic_ticks.csv",
        "data/orders.csv",
        "data/trades.csv",
        "0.0005",
        "0.0002",
        "backtest",
        "logs/backtest.log"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "preLaunchTask": "Build backtest_main"
    }
  ]
}