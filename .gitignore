# --------------------------------------------------
# C++ 构建产物 / 可执行文件 / 动态静态库
# --------------------------------------------------
build/
out/
bin/
*.o
*.obj
*.so
*.dylib
*.a
*.lib
*.dll
*.exe
*.out

# --------------------------------------------------
# CMake 产生的临时文件
# --------------------------------------------------
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json
*.cmake
!CMakeLists.txt

# --------------------------------------------------
# 编辑器与 IDE (保留 VS Code 共享配置文件)
# --------------------------------------------------
# Visual Studio 重型缓存/个人配置
.vs/
*.user
*.suo

# JetBrains / Sublime
.idea/
*.sublime-workspace
*.sublime-project

# VS Code：忽略所有缓存/本地文件，但精确保留共享配置
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# --------------------------------------------------
# 项目运行/回测生成的日志与临时数据
# --------------------------------------------------
# 保持 logs 目录在 Git 中存在，但忽略里面的具体 .log 文件
logs/*
!logs/.gitkeep

# 回测/实盘运行产生的中间交易记录
data/orders.csv
data/trades.csv

# 通用系统临时文件与编辑器缓存
*.log
*.tmp
*.swp
*~
.DS_Store
Thumbs.db