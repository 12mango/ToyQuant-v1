# ----------------------
# 构建输出目录
# ----------------------
/build/
*.o
*.obj
*.so
*.a
*.dll
*.exe
*.out

# ----------------------
# CMake 临时文件
# ----------------------
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json
*.cmake

# ----------------------
# 编辑器 / IDE 文件
# ----------------------
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# ----------------------
# 临时 / 日志 / 其他
# ----------------------
*.log
*.tmp
*.swp
*.DS_Store

# 忽略日志输出文件夹（但保留目录结构可以用下面的技巧）
/logs/*
!/logs/.gitkeep

# 忽略 CMake 编译产物
/build/
/out/
/bin/

# 忽略 IDE 个人配置
/.vs/
/.vscode/
