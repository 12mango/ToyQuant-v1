# --------------------------------------------------
# C++ build artifacts / executables / shared and static libraries
# --------------------------------------------------
build/
out/
bin/
*.o
*.obj
*.so
*.dylib
*.a
*.lib
*.dll
*.exe
*.out

# --------------------------------------------------
# CMake-generated temporary files
# --------------------------------------------------
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
compile_commands.json
*.cmake
!CMakeLists.txt

# MkDocs-generated site; published as a Pages artifact by GitHub Actions
site/

# --------------------------------------------------
# Editors and IDEs (keep shared VS Code configuration files)
# --------------------------------------------------
# Visual Studio cache and personal configuration
.vs/
*.user
*.suo

# JetBrains / Sublime
.idea/
*.sublime-workspace
*.sublime-project

# VS Code: ignore local and cache files while keeping shared configuration
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# --------------------------------------------------
# Runtime and backtest logs and temporary data
# --------------------------------------------------
# Keep the logs directory in Git while ignoring individual .log files
logs/*
!logs/.gitkeep

# Intermediate trading records generated by backtest or live runs
data/orders.csv
data/trades.csv
data/runtime/*
!data/runtime/.gitkeep

# Large Binance replay datasets; keep the small test_* fixtures tracked.
data/v2/BTCUSDT-aggTrades-*.csv
data/v2/BTCUSDT-bookTicker-*.csv
data/v2/*.csv:Zone.Identifier

# Visualization reports: keep the README example image and ignore other outputs
reports/*
!reports/synthetic_ticks_optimized.png

# General system temporary files and editor caches
*.log
*.tmp
*.swp
*~
__pycache__/
.venv/
.DS_Store
Thumbs.db